# Required: any command that reads the prompt on stdin (or MISSION.md) and
# writes the final reply to stdout. The rollout command and the harness
# improver may differ.
IMPRO_AGENT_CMD=claude -p
# IMPRO_PROPOSER_CMD=claude -p
# IMPRO_SELECTOR_CMD=claude -p
# IMPRO_RUNS_DIR=runs
# IMPRO_HARNESS=harness
# IMPRO_TRANSPORT_ATTEMPTS=2
# IMPRO_PROPOSER_CONCURRENCY=2

# The coding workflow uses the command channel above. The benchmark
# reproductions (impro adapt/judge/report) use the upstream OpenCode/Codex
# channels and their provider/model settings:
# IMPRO_PROPOSER_CHANNEL=opencode
# IMPRO_SOLVER_MODEL=google-vertex/gemini-2.5-pro
# IMPRO_IMPROVER_MODEL=google-vertex/gemini-2.5-pro
# IMPRO_JUDGE_MODEL=gemini-2.5-pro
# IMPRO_PHASE_WIDTH=2
# GOOGLE_CLOUD_PROJECT=your-project
# GOOGLE_CLOUD_LOCATION=global
# IMPRO_JUDGE_BASE_URL=
# IMPRO_JUDGE_API_KEY=
# IMPRO_CODEX_BASE_URL=
# IMPRO_CODEX_API_KEY=
# IMPRO_CODEX_MODEL=
# IMPRO_CODEX_CONTAINER_URL=
